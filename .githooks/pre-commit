#!/usr/bin/env bash
set -euo pipefail

if (( BASH_VERSINFO[0] < 4 )); then
  echo "pre-commit needs bash >= 4 (e.g. brew install bash)"
  exit 1
fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

# Auto-format Rust workspace before committing.
if command -v cargo >/dev/null 2>&1; then
    if ! cargo fmt --all -- --check 2>/dev/null; then
        echo "Running cargo fmt..."
        cargo fmt --all
        echo "Formatted. Please review and re-stage the changes."
        exit 1
    fi
fi

# Use the same fast maintainability checks exposed to agents and contributors.
bash tools/check.sh guardrails
