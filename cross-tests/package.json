{
  "name": "kms-cross-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:wasm-types": "tsc --ignoreConfig --noEmit --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution bundler src/verify-wasm-null-types.ts",
    "verify": "tsx src/verify-rust-proofs.ts",
    "verify:wasm": "tsx src/verify-wasm-bindings.ts",
    "verify:snip12": "tsx src/verify-snip12-vectors.ts",
    "verify:tx-hashes": "tsx src/generate-tx-hash-vectors.ts",
    "test": "npm run verify"
  },
  "dependencies": {
    "@fatsolutions/tongo-sdk": "1.3.2",
    "starknet": "^10.8.0",
    "starknet-10": "npm:starknet@10.0.2"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
